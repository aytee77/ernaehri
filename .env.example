# Optional configuration for Ernähri (see README → "Konfiguration").
# Every variable has a default – the app runs without any of them.
# Copy to .env.local and fill in what you need:
#
#   cp .env.example .env.local

# --- Migros products & prices ----------------------------------------------
# Without MIGROS_API_KEY the public Migusto client key is used.
#MIGROS_API_KEY=
#MIGROS_API_URL=https://api.migros.ch

# --- User agents for the recipe sources ------------------------------------
#MIGUSTO_USER_AGENT=
#BETTYBOSSI_USER_AGENT=
#FOOBY_USER_AGENT=

# --- Bring! export (optional, enabled as soon as email + password are set) --
# Password login only – accounts created via Google/Apple have no password.
#BRING_EMAIL=
#BRING_PASSWORD=
#BRING_LIST_NAME=Ernähri
#BRING_API_URL=https://api.getbring.com/rest/v2
#BRING_API_KEY=
#BRING_COUNTRY=CH
#BRING_CLIENT=webApp
